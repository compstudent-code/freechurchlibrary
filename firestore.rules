rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.status == "approved";
    }

    function canUseLibrary() {
      return isAdmin() || isApproved();
    }

    function isVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function validPhone(phone) {
      return phone is string && phone.size() <= 32
        && phone.matches("^[0-9+(). -]*$");
    }

    function checkoutId(bookId, uid) {
      return bookId + "_" + uid;
    }

    match /settings/{settingId} {
      allow read: if settingId == "public";
      allow create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /access/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /members/{uid} {
      allow get: if isAdmin() || (isApproved() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isApproved()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["displayName", "phone", "updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && validPhone(request.resource.data.phone)
      );
    }

    match /accessRequests/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isVerifiedEmail()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/access/$(uid))
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "email", "phone", "status", "requestedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && validPhone(request.resource.data.phone);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /books/{bookId} {
      allow read: if canUseLibrary();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isApproved()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["availableCopies", "updatedAt"])
        && request.resource.data.availableCopies is int
        && resource.data.availableCopies is int
        && request.resource.data.availableCopies == resource.data.availableCopies - 1
        && resource.data.availableCopies > 0
        && resource.data.active == true
        && (
          !exists(/databases/$(database)/documents/checkouts/$(checkoutId(bookId, request.auth.uid)))
          || get(/databases/$(database)/documents/checkouts/$(checkoutId(bookId, request.auth.uid))).data.status == "returned"
        )
        && getAfter(/databases/$(database)/documents/checkouts/$(checkoutId(bookId, request.auth.uid))).data.status == "active"
        && getAfter(/databases/$(database)/documents/checkouts/$(checkoutId(bookId, request.auth.uid))).data.bookId == bookId
        && getAfter(/databases/$(database)/documents/checkouts/$(checkoutId(bookId, request.auth.uid))).data.uid == request.auth.uid
      );
    }

    match /checkouts/{checkoutDocumentId} {
      allow get, list: if isAdmin()
        || (isApproved() && resource.data.uid == request.auth.uid);
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly([
          "bookId", "bookTitle", "uid", "memberName", "memberEmail",
          "status", "checkedOutAt", "returnedAt", "memberPhone"
        ])
        && request.resource.data.uid == request.auth.uid
        && checkoutDocumentId == checkoutId(request.resource.data.bookId, request.auth.uid)
        && request.resource.data.status == "active"
        && request.resource.data.bookTitle is string
        && request.resource.data.bookTitle.size() <= 160
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() > 0
        && request.resource.data.memberName.size() <= 100
        && request.resource.data.memberEmail == request.auth.token.email
        && validPhone(request.resource.data.memberPhone)
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.displayName == request.resource.data.memberName
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.phone == request.resource.data.memberPhone
        && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.active == true
        && get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.title == request.resource.data.bookTitle
        && getAfter(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.availableCopies
          == get(/databases/$(database)/documents/books/$(request.resource.data.bookId)).data.availableCopies - 1;
      allow update: if isAdmin() || (
        isApproved()
        && resource.data.uid == request.auth.uid
        && resource.data.status == "returned"
        && request.resource.data.status == "active"
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.uid == resource.data.uid
        && checkoutDocumentId == checkoutId(resource.data.bookId, request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "checkedOutAt", "returnedAt", "bookTitle", "memberName", "memberEmail", "memberPhone"])
        && request.resource.data.bookTitle is string
        && request.resource.data.memberEmail == request.auth.token.email
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.displayName == request.resource.data.memberName
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.phone == request.resource.data.memberPhone
        && get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.active == true
        && get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.title == request.resource.data.bookTitle
        && validPhone(request.resource.data.memberPhone)
        && getAfter(/databases/$(database)/documents/books/$(resource.data.bookId)).data.availableCopies
          == get(/databases/$(database)/documents/books/$(resource.data.bookId)).data.availableCopies - 1
      );
      allow delete: if false;
    }
  }
}
